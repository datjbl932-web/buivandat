# Sao chép thành .env rồi sửa
PORT=8080
# Mật khẩu quản trị (dashboard mục Quản trị + API /admin). Đặt chuỗi dài, ngẫu nhiên.
ADMIN_TOKEN=doi-thanh-chuoi-ngau-nhien-dai
DB_PATH=./data/datcrawl.db

# Proxy: mỗi dòng một proxy trong file proxies.txt, hoặc liệt kê ở đây (cách nhau bởi dấu phẩy).
# Định dạng: http://user:pass@host:port | host:port | host:port:user:pass
PROXIES_FILE=./proxies.txt
PROXIES=
# Cho phép gọi thẳng từ IP máy chủ khi không có proxy (Amazon sẽ chặn IP VPS rất nhanh)
USE_DIRECT=false

# Hiệu năng & lịch sự với website đích
CONCURRENCY=10
PER_DOMAIN_CONCURRENCY=4
PER_PROXY_DELAY_MS=1500
MAX_RETRIES=4
TIMEOUT_MS=30000
CACHE_TTL_SEC=3600
DEFAULT_RATE_LIMIT=60
JOB_WORKERS=4

# Mở trang bằng trình duyệt thật cho &javascript=true (cần: npm i playwright && npx playwright install --with-deps chromium)
ENABLE_JS=false
LOG_LEVEL=info
