{
  "name": "datcrawl",
  "version": "0.1.0",
  "description": "API crawl dữ liệu tự host (tương thích Crawlbase): proxy xoay vòng, tự thử lại khi bị chặn, scraper Amazon trả JSON, job hàng loạt + webhook, dashboard.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "datcrawl": "bin/datcrawl.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.5",
    "undici": "^7.30.0"
  }
}
